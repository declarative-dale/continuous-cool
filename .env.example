# This value determines Matrix user and room IDs.
# It cannot practically be changed after initialization.
MATRIX_SERVER_NAME=example.org

# Public hostname where Coolify exposes the Continuwuity service.
# This may equal MATRIX_SERVER_NAME, but a subdomain is conventional.
MATRIX_SERVICE_HOSTNAME=matrix.example.org

# Pin this to a tested stable Continuwuity release.
CONTINUWUITY_VERSION=v26.7.3
